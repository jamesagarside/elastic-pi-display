[Unit]
Description=Elastic Security Display backend
Documentation=https://github.com/jamesagarside/elastic-security-display
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=elastic-display
Group=elastic-display
ExecStart=/opt/elastic-security-display/venv/bin/elastic-display run
Restart=always
RestartSec=5

# Hardening — the service only needs to read its config and serve HTTP.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=/etc/elastic-security-display

[Install]
WantedBy=multi-user.target
