# Kiosk unit for SPI TFT panels (fbtft framebuffer, no DRM/KMS device): a
# minimal X server with the fbdev driver runs Chromium. Installed by
# install.sh --spi-panel in place of the cage unit — wlroots compositors
# cannot output to fbtft framebuffers.
[Unit]
Description=Elastic Pi Display kiosk (X11 fbdev + Chromium)
After=systemd-user-sessions.service elastic-pi-display.service
Conflicts=getty@tty1.service

[Service]
Type=simple
User=pi
# '+' = run as root: resolves the panel's framebuffer number (not stable
# across boots) and writes the X fbdev config before the server starts.
ExecStartPre=+/opt/elastic-pi-display/set-fbdev.sh
ExecStart=/usr/bin/xinit /opt/elastic-pi-display/kiosk.sh -- :0 vt1 -keeptty -noreset -nolisten tcp -nocursor
Restart=on-failure
RestartSec=5
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user

[Install]
WantedBy=multi-user.target
